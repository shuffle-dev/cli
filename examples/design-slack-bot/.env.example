SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-socket-mode-token
# Optional. Set to DEBUG when diagnosing Socket Mode or event delivery.
SLACK_LOG_LEVEL=INFO

# Optional. Defaults to npx @shuffle-dev/cli.
# When Shuffle CLI is installed globally, you can use "shuffle"
#SHUFFLE_CLI=shuffle
# or locally
#SHUFFLE_CLI=node ./node_modules/@shuffle-dev/cli/bin/shuffle.js

# Pick either SHUFFLE_MODEL or SHUFFLE_ALL_MODELS=true.
SHUFFLE_MODEL=claude-opus-4-7
# SHUFFLE_ALL_MODELS=true

# Optional.
SHUFFLE_SCREENSHOT=true
SHUFFLE_TIMEOUT_MS=900000
